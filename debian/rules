#!/usr/bin/make -f

%:
	dh $@

override_dh_dwz:

override_dh_auto_clean:
	rm -rf build

override_dh_auto_configure:
	# Copy pretuned TL2 kernels for 2B4T model (x86-64)
	cp preset_kernels/bitnet_b1_58-3B/bitnet-lut-kernels-tl2.h include/bitnet-lut-kernels.h
	# Kernel header uses AVX2 types without including immintrin.h
	sed -i '1i #include <immintrin.h>' include/bitnet-lut-kernels.h

	# Fix upstream const-correctness bug (clang strict mode)
	sed -i 's/int8_t \* y_col = y/const int8_t * y_col = y/' src/ggml-bitnet-mad.cpp

	# Patch for systemd socket activation
	sed -i '1a #include <cstdlib>' 3rdparty/llama.cpp/examples/server/server.cpp
	sed -i '/^  bool bind_to_port/i \  bool set_socket(socket_t sock) { svr_sock_ = sock; return true; }' \
		3rdparty/llama.cpp/examples/server/httplib.h
	sed -i '/bind HTTP listen port/a \    bool using_systemd = false;\
    const char *fds = getenv("LISTEN_FDS");\
    const char *pid = getenv("LISTEN_PID");\
    if (fds && pid && atoi(pid) == getpid() && atoi(fds) >= 1) {\
        svr->set_socket(3);\
        using_systemd = true;\
        unsetenv("LISTEN_FDS"); unsetenv("LISTEN_PID");\
        LOG_INF("using systemd socket activation (fd 3)\\n");\
    }' 3rdparty/llama.cpp/examples/server/server.cpp
	sed -i 's/if (!svr->bind_to_port/if (!using_systemd \&\& !svr->bind_to_port/' \
		3rdparty/llama.cpp/examples/server/server.cpp

	# Configure
	mkdir -p build
	cd build && cmake .. \
		-DCMAKE_BUILD_TYPE=Release \
		-DBITNET_X86_TL2=ON \
		-DCMAKE_C_COMPILER=clang \
		-DCMAKE_CXX_COMPILER=clang++ \
		-DCMAKE_C_FLAGS="-mavx2" \
		-DCMAKE_CXX_FLAGS="-mavx2" \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_SKIP_RPATH=ON \
		-DBUILD_SHARED_LIBS=OFF

override_dh_auto_build:
	cd build && $(MAKE) llama-server

override_dh_auto_install:
	install -D -m 0755 build/bin/llama-server \
		$(CURDIR)/debian/bitnet-server/usr/bin/llama-server
